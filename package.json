{
  "name": "dsh-mindsee",
  "version": "0.1.0",
  "license": "MIT",
  "description": "DeepSeek Harness 插件：以 MindSee 为后端，为 DeepSeek 提供图片相关能力",
  "author": "cdx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/123cdxcc/dsh-mindsee.git"
  },
  "homepage": "https://github.com/123cdxcc/dsh-mindsee#readme",
  "bugs": {
    "url": "https://github.com/123cdxcc/dsh-mindsee/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "pnpm build",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mindsee",
    "describe_image"
  ],
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
